# ─────────────────────────────────────────────────────────────
# Forge Learning — environment variables
# Copy this file to `.env.local` and fill in your values.
# The landing page works WITHOUT these set — it falls back to
# logging waitlist signups in the /api/waitlist route (local-only mode).
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (safe to expose to the browser).
# After W-ANON (forge-app 0025/0026) this key has no table privilege on
# `waitlist`; signups go only through the route's join_waitlist() RPC call.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: Never put the service_role / secret key in a NEXT_PUBLIC_* variable.
# It is not required for this landing page.

# Server-only secret the /api/waitlist route sends to public.join_waitlist().
# The database stores only its sha256. Set it in Vercel's server-side
# environment (NEVER as NEXT_PUBLIC_*), never commit a value. Without it the
# route answers 500 for every signup (fail closed).
WAITLIST_ROUTE_SECRET=
