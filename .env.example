# ─────────────────────────────────────────────────────────────
# Forge Learning — environment variables
# Copy this file to `.env.local` and fill in your values.
# The landing page works WITHOUT these set — it falls back to
# logging waitlist signups in the /api/waitlist route (local-only mode).
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (safe to expose to the browser).
# This key is gated by Row Level Security (INSERT-only policy on `waitlist`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: Never put the service_role / secret key in a NEXT_PUBLIC_* variable.
# It is not required for this landing page.
